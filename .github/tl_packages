# TeX Live packages required to build the slides.
#
# The bulk of this list was derived from the .fls recorder output of a full
# local build; the extras below are the ones that only the shell-escape
# sub-compiles or the format build need. Keep it in sync when a deck starts
# using a new package, otherwise the build fails on a missing .sty.
#
# Validate names against the *remote* repository, not a local installation --
# packages get merged upstream and a name that still resolves locally can be
# gone from tlnet (l3backend was folded into l3kernel exactly that way):
#
#   curl -sSL https://mirror.ctan.org/systems/texlive/tlnet/tlpkg/texlive.tlpdb.xz \
#     | xz -dc | grep -oE '^name [a-zA-Z0-9._-]+$' | sed 's/^name //' | sort -u

scheme-basic
latexmk

# Hyphenation patterns for the babel languages in use.
hyphen-english
hyphen-german

